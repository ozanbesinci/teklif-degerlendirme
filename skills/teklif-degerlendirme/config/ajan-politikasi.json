{
  "policy_version": "3.0.1",
  "max_coordinator_workers": 3,
  "roles": {
    "coordinator": {"model": "gpt-5.6-sol", "reasoning_effort": "high", "can_dispatch": true},
    "reviewer": {"model": "gpt-5.6-sol", "reasoning_effort": "high", "independent_required": true},
    "extraction": {"model": "gpt-5.6-terra", "reasoning_effort": "medium"},
    "extraction_difficult": {"model": "gpt-5.6-terra", "reasoning_effort": "high"},
    "requirements": {"model": "gpt-5.6-terra", "reasoning_effort": "high"},
    "technical": {"model": "gpt-5.6-terra", "reasoning_effort": "high"},
    "financial": {"model": "gpt-5.6-terra", "reasoning_effort": "high"},
    "contracts": {"model": "gpt-5.6-terra", "reasoning_effort": "high"},
    "classifier": {"model": "gpt-5.6-terra", "reasoning_effort": "medium"},
    "classifier_complex": {"model": "gpt-5.6-terra", "reasoning_effort": "medium"},
    "critical_adjudicator": {"model": "gpt-6-astra", "reasoning_effort": "high", "conditional": true}
  },
  "forbidden_models": ["gpt-5.6-luna"],
  "worker_config": {"agents.enabled": false},
  "notes": [
    "Role, model and reasoning effort are selected only from this policy; CLI overrides are intentionally absent.",
    "caller identity is an asserted workflow field, not cryptographic authentication.",
    "No retry/fallback role or model is configured."
  ]
}
